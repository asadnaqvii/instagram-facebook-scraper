# Copy to .env and edit as needed. All values are optional — sensible
# defaults live in config.py.

# --- CDP: connect to your own logged-in Chrome ---
CDP_PORT_FACEBOOK=9222
CDP_PORT_INSTAGRAM=9223
BROWSER_TIMEOUT_MS=60000

# --- Scraping behaviour ---
MAX_SCROLLS=20
DOWNLOAD_MEDIA=true
MAX_MEDIA_FILESIZE=80M
MAX_COMMENTS_PER_POST=50

# --- Ollama (local LLM for self-healing selectors + content analysis) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_ENABLED=true
LLM_SELECTOR_HEALING=true
LLM_CONTENT_ANALYSIS=true

# --- Storage ---
# META_OSINT_DATA_DIR=F:/Meta scraper/meta_osint/data
# META_OSINT_DB=F:/Meta scraper/meta_osint/data/meta_osint.db
