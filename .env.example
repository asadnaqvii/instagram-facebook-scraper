# ── meta_osint — copy to `.env` and fill in ─────────────────────────────────
# Everything here is read by meta_osint/config.py at startup. Copy this file to
# `.env` (same folder) and set your values. `.env` is gitignored — never commit
# real credentials.

# ── Database backend ────────────────────────────────────────────────────────
# 'sqlite' = local file (default).  'mysql' = shared server (fill MYSQL_* below).
META_OSINT_DB_BACKEND=mysql

# MySQL connection (only used when backend=mysql)
MYSQL_HOST=192.168.1.100
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=your_database_name

# ── Paths (RELATIVE to the code folder — leave unset for portability) ────────
# By default DATA_DIR = <meta_osint>/data and MEDIA_DIR = <meta_osint>/data/media,
# both resolved relative to the code itself. That means: copy the code folder
# (with data/media inside it) to another PC and media resolves with NO changes.
# Only set these if you want the data/media somewhere else.
#
# META_OSINT_DATA_DIR=./meta_osint/data      # optional override
# META_OSINT_DB=./meta_osint/data/meta_osint.db  # SQLite path (sqlite backend only)

# ── LLM (Ollama) — must be running locally on the target PC ──────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_ENABLED=true

# ── Browser CDP ports (Chrome launched by scripts/start_chrome_*.bat) ────────
CDP_PORT_FACEBOOK=9222
CDP_PORT_INSTAGRAM=9223

# ── Coverage: how much we collect per keyword ────────────────────────────────
# Facebook search alone returns a thin, often off-topic slice. Volume comes from
# more surfaces + the feeds of discovered pages/accounts.
FB_SEARCH_SURFACES=posts,recent,reels,hashtag,videos
FB_SEARCH_MIN_RELEVANCE=35      # 35 keeps any real word match; 50 = all-words/phrase only
FB_PAGE_FEEDS=4                  # scrape feeds of top N discovered pages (0=off)
FB_POSTS_PER_PAGE=6
IG_MAX_POSTS_CAP=25
IG_ACCOUNT_FEEDS=3               # recent posts from top N discovered IG accounts
IG_POSTS_PER_ACCOUNT=6
# Parallel tabs for independent sources within one platform. 1 = sequential
# (safest). 2-3 is faster but one account visibly browses several pages at once.
SOURCE_CONCURRENCY=1

# ── Proxy (Chrome-level) ─────────────────────────────────────────────────────
# Only if this machine is on a datacenter IP. Use ONE STICKY RESIDENTIAL proxy
# for the whole session; NEVER rotate IPs under a logged-in account (Meta reads
# it as impossible travel and checkpoints the account). No user:pass support —
# use an IP-whitelisted endpoint. Example: CHROME_PROXY=http://10.0.0.5:8888
# CHROME_PROXY=
