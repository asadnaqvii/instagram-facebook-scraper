# ── meta_osint — copy to `.env` and fill in ─────────────────────────────────
# Everything here is read by meta_osint/config.py at startup. Copy this file to
# `.env` (same folder) and set your values. `.env` is gitignored — never commit
# real credentials.

# ── Database backend ────────────────────────────────────────────────────────
# 'sqlite' = local file (default).  'mysql' = shared server (fill MYSQL_* below).
META_OSINT_DB_BACKEND=mysql

# MySQL connection (only used when backend=mysql)
MYSQL_HOST=192.168.3.161
MYSQL_PORT=3306
MYSQL_USER=AIUser01
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB=your_database_name

# ── Paths (RELATIVE to the code folder — leave unset for portability) ────────
# By default DATA_DIR = <meta_osint>/data and MEDIA_DIR = <meta_osint>/data/media,
# both resolved relative to the code itself. That means: copy the code folder
# (with data/media inside it) to another PC and media resolves with NO changes.
# Only set these if you want the data/media somewhere else.
#
# META_OSINT_DATA_DIR=./meta_osint/data      # optional override
# META_OSINT_DB=./meta_osint/data/meta_osint.db  # SQLite path (sqlite backend only)

# ── LLM (Ollama) — must be running locally on the target PC ──────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
LLM_ENABLED=true

# ── Browser CDP ports (Chrome launched by scripts/start_chrome_*.bat) ────────
CDP_PORT_FACEBOOK=9222
CDP_PORT_INSTAGRAM=9223
